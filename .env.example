# --- Secrets (required, never commit the real .env) ---
AI_API_KEY=changeme
HA_BASE_URL=http://homeassistant.local:8123
HA_LONG_LIVED_TOKEN=changeme
HA_WEBHOOK_SECRET=changeme

# --- AI species identification / diagnosis ---
# openai          -> POST {base}/chat/completions with Authorization: Bearer
# azure-openai    -> POST {base}/openai/deployments/{model}/chat/completions?api-version=...
AI_API_STYLE=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Only used when AI_API_STYLE=azure-openai.
AI_API_VERSION=2024-10-21
# Separate, optionally stronger model used only for the "diagnose plant
# issues" feature (yellowing leaves, pests, etc.).
AI_DIAGNOSE_MODEL=gpt-4.1
# Optional: free Perenual API key (https://perenual.com/docs/api) for better
# watering-interval data. Leave blank to skip straight to AI + defaults.
PERENUAL_API_KEY=

# --- Deployment ---
APP_PUBLIC_URL=http://localhost:8080
DB_PATH=data/droplet.sqlite3
PHOTOS_DIR=data/photos

# --- Notifications ---
# Comma-separated HA notify.mobile_app_* suffixes, e.g. mobile_app_phone1,mobile_app_phone2
NOTIFY_TARGETS=
# IANA timezone name (e.g. Europe/Budapest, America/New_York) — used to
# interpret QUIET_HOURS_START/END and the twice-daily overdue reminders
# (09:00/18:00) in your local time. Defaults to UTC if left unset.
TIMEZONE=UTC
QUIET_HOURS_START=22
QUIET_HOURS_END=8

# --- Seasonal cadence ---
# northern | southern
HEMISPHERE=northern

# --- Language ---
# Language for push notifications AND for AI-suggested plant names (photo
# identification): en | hu. Static setting matching the phone's language — no
# in-app switcher.
LANGUAGE=en
